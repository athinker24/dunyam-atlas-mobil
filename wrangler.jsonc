// Cloudflare Workers (yalniz statik dosya). Derleme komutu "sh yayinla.sh"
// site/'yi kurar, "npx wrangler deploy" onu yayinlar. Motor ve dunya
// tanimi site/'ye girmez. Onunde Cloudflare Access durur (panelden acildi).
{
  "name": "dunyam-atlas-mobil",
  "compatibility_date": "2026-06-01",
  "assets": { "directory": "./site" },
  "preview_urls": true,
  // ana dal disindaki dallarda Cloudflare "wrangler preview" kosar; bu blok
  // olmadan yayin adimi duser (su-butcesi dalinda olculdu)
  "previews": {}
}
